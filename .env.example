# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/navratri-distribution
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/navratri-distribution

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Initial Admin Seed (used by: npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@navratri.local
ADMIN_PASSWORD=change-this-password

# Node Environment
NODE_ENV=development
